class ThreadedServer(ThreadingMixIn, HTTPServer): daemon_threads = True

if __name__ == '__main__':
    threading.Thread(target=_input_listener, daemon=True).start()
    threading.Thread(target=_fire_scheduler, daemon=True).start()   # 发射冷却调度
    srv = ThreadedServer(('0.0.0.0', 18776), Handler)
    print(f'弹幕接收 → http://localhost:18776')
    print(f'配置: 秒发={_config["fire"]} 组合={_config["clip_limit"]} 丢弃={_config["discard"]} 输出桥={_config["out_bridge"]} 冷却={_config.get("cooldown", 5)}s')
    srv.serve_forever()
