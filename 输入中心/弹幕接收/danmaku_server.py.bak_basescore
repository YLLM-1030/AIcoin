  </div>
</div>

<script>
var _es = null;

(function(){
  connectSSE();
})();

function connectSSE(){
  if(_es) _es.close();
  _es = new EventSource('/events');
  _es.addEventListener('state', function(e){
    try{ var d = JSON.parse(e.data); updateState(d); }catch(e){}
  });
  _es.addEventListener('config', function(e){
    try{ var c = JSON.parse(e.data); updateCfgUI(c); }catch(e){}
  });
  _es.addEventListener('fire', function(e){
    try{ var d = JSON.parse(e.data); }catch(e){ return; }
    // 只更新右侧标题的模式标签，左侧 feed 不再插入提示行/图标
    if(d.fire_count) document.getElementById('mode-tag').textContent = '秒回 x'+d.fire_count;
    if(d.flush_count) document.getElementById('mode-tag').textContent = '组合发送 x'+d.flush_count;
  });
  _es.onopen = function(){ setStatus('已连接', 'ok'); };
  _es.onerror = function(){
    setStatus('断开, 3s重连...', 'err');
    if(_es.readyState === EventSource.CLOSED) setTimeout(connectSSE, 3000);
  };
}

var _autoRefreshTimer = null;   // 自动刷新定时器（1s 轮询 /api/state）
function toggleAutoRefresh(){
  var btn = document.getElementById('auto-refresh-btn');
  if(_autoRefreshTimer){
    clearInterval(_autoRefreshTimer);
    _autoRefreshTimer = null;
    btn.textContent = '🔄 自动刷新: 关';
    btn.className = 'dim';
  } else {
    _autoRefreshTimer = setInterval(pollState, 1000);
    btn.textContent = '🔄 自动刷新: 开';
    btn.className = 'green';
    pollState();   // 开启立即刷一次
  }
}
function pollState(){
  fetch('/api/state').then(function(r){ return r.json(); }).then(function(d){
    if(d && d.raw) updateState(d);
  }).catch(function(){});
}

var _feedLen = 0;   // 左侧 feed 已显示到 raw 的第几条（去重用）
var _sentLen = 0;   // 已发送列已显示到 sent 的第几条（去重用）

function updateState(d){
  var raw = d.raw || [], pending = d.pending || [], saved = d.saved || [],
      discarded = d.discarded || [], sc = d.sc || [], sent = d.sent || [],
      qf = d.pending_fire || [];
  document.getElementById('raw-cnt').textContent = raw.length;
  document.getElementById('pend-cnt').textContent = pending.length;
  document.getElementById('saved-cnt').textContent = saved.length;
  document.getElementById('disc-cnt').textContent = discarded.length;
  document.getElementById('sc-cnt').textContent = sc.length;
  document.getElementById('sent-cnt').textContent = sent.length;
  document.getElementById('qf-cnt').textContent = qf.length;
  document.getElementById('queue-fire').innerHTML = rlistQueue(qf);
  var rem = d.fire_remaining || 0;
  var cdEl = document.getElementById('cd-left');
  if(cdEl){
    if(qf.length) cdEl.textContent = '冷却 '+rem.toFixed(1)+'s 后发射下一组';
    else if(rem > 0) cdEl.textContent = '冷却中 '+rem.toFixed(1)+'s';
    else cdEl.textContent = '就绪';
  }
  window._savedSum = d.saved_sum||0;
  _refreshSavedSum(window._savedSum);

  document.getElementById('raw').innerHTML = rlistRaw(raw.slice(-100), '等待弹幕...');
  document.getElementById('pending').innerHTML = rlistPend(pending.slice(-100), '等待弹幕...');
  document.getElementById('saved').innerHTML = rlistPend(saved.slice(-50));
  document.getElementById('discarded').innerHTML = rlistPend(discarded.slice(-50));
  document.getElementById('sc-list').innerHTML = rlistPend(sc.slice(-30), '暂无');

  // 左侧 feed：只追加新到的原文行（原样，无分数）
  var feed = document.getElementById('dm-feed');
  if(_feedLen > raw.length) _feedLen = 0;               // 服务端滚动截断 → 从头补
  if(feed.children.length===1 && feed.children[0].textContent.startsWith('等待')) feed.innerHTML='';
  for(var i = _feedLen; i < raw.length; i++){
    var x = raw[i];
    var div = document.createElement('div');
    div.className = 'dm-line';
    div.textContent = x.line;
    feed.appendChild(div);
  }
  _feedLen = raw.length;
  feed.scrollTop = feed.scrollHeight;

  // 最右已发送列：只追加新发射的（原样，无分数）
  var sfeed = document.getElementById('sent-feed');
  if(_sentLen > sent.length) _sentLen = 0;
  if(sfeed.children.length===1 && sfeed.children[0].textContent.startsWith('暂无')) sfeed.innerHTML='';
  for(var j = _sentLen; j < sent.length; j++){
    var sx = sent[j];
    var sdiv = document.createElement('div');
    sdiv.className = 'dm-line';
    sdiv.textContent = sx.line;
    sfeed.appendChild(sdiv);
  }
  _sentLen = sent.length;
  sfeed.scrollTop = sfeed.scrollHeight;
}

function _refreshSavedSum(sum){
  var el = document.getElementById('saved-sum');
  if(el) el.textContent = '总分 '+(sum||0).toFixed(2)+' / '+((window._clipLimit||0.30)).toFixed(2);
}

function updateCfgUI(c){
  document.getElementById('cfg-fire').value = c.fire;
  document.getElementById('cfg-clip').value = c.clip_limit;
  document.getElementById('cfg-discard').value = c.discard;
  document.getElementById('cfg-out').value = c.out_bridge || '';
  document.getElementById('cfg-in').value = c.in_bridge || '19000';
  if(c.cooldown) document.getElementById('cfg-cd').value = c.cooldown;
  window._fireThreshold = c.fire;
  window._clipLimit = c.clip_limit;
  window._discardThreshold = c.discard;
  _refreshSavedSum(window._savedSum||0);   // 阈值更新后立即重绘总分显示
}

function saveThresholds(){
  var cfg = {
    fire: parseFloat(document.getElementById('cfg-fire').value)||0.30,
    clip_limit: parseFloat(document.getElementById('cfg-clip').value)||0.30,
    discard: parseFloat(document.getElementById('cfg-discard').value)||0.11
  };
  window._fireThreshold = cfg.fire;
  window._clipLimit = cfg.clip_limit;
  window._discardThreshold = cfg.discard;
  fetch('/api/config', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(cfg)}).then(function(){
    document.getElementById('save-th-ok').style.display = 'inline';
    setTimeout(function(){ document.getElementById('save-th-ok').style.display = 'none'; }, 2000);
  });
}

function saveCooldown(){
  var v = parseFloat(document.getElementById('cfg-cd').value)||5;
  fetch('/api/config', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({cooldown: v})}).then(function(){
    document.getElementById('save-cd-ok').style.display = 'inline';
    setTimeout(function(){ document.getElementById('save-cd-ok').style.display = 'none'; }, 2000);
  });
}

function saveInputBridge(){
  var v = document.getElementById('cfg-in').value;
  fetch('/api/config', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({in_bridge: v})}).then(function(){
    setStatus('输入桥已保存: '+v+', 重连中...');
    setTimeout(function(){ connectSSE(); }, 500);
  });
}

function saveOutBridge(){
  var v = document.getElementById('cfg-out').value;
  fetch('/api/config', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({out_bridge: v})}).then(function(){
    document.getElementById('save-out-ok').style.display = 'inline';
    setTimeout(function(){ document.getElementById('save-out-ok').style.display = 'none'; }, 2000);
  });
}

function apiPost(url){
  fetch(url, {method:'POST'}).then(function(){});
}

function flushBridge(){
  fetch('/api/flush', {method:'POST'}).then(function(r){ return r.json(); }).then(function(d){
    alert('已加入待发射队列 '+d.count+' 条（队列 '+d.queued+' 组）');
  });
}

function testDm(){
  var u = document.getElementById('test-user').value.trim()||'观众';
  var t = document.getElementById('test-text').value.trim();
  if(!t) return;
  document.getElementById('test-text').value = '';
  fetch('/api/test', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({user:u, text:t})});
}

function testSC(){
  var u = document.getElementById('test-sc-user').value.trim()||'老板';
  var t = document.getElementById('test-sc-text').value.trim();
  var p = parseInt(document.getElementById('test-sc-price').value)||30;
  if(!t) return;
  document.getElementById('test-sc-text').value = '';
  fetch('/api/test', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({user:u, text:t, price:p, type:'sc'})});
}

function setStatus(msg, cls){
  var s = document.getElementById('status');
  s.textContent = msg; s.className = cls||'';
}

function rlistRaw(arr, empty){
  // 原文块：输入原样，不加工
  if(!arr.length) return '<div style="color:#484f58">'+(empty||'暂无')+'</div>';
  return arr.map(function(x){
    return '<div class="item"><span class="t">'+esc(x.line)+'</span><span class="a">'+x.time+'</span></div>';
  }).join('');
}

function rlistPend(arr, empty){
  // 待分类/已存/已丢弃：格式化文本 + 分数
  if(!arr.length) return '<div style="color:#484f58">'+(empty||'暂无')+'</div>';
  return arr.map(function(x){
    var st = '';
    if(x.score >= (window._fireThreshold||0.3)) st = '<span class="s" style="background:#b08800;color:#fff">🔫'+x.score.toFixed(2)+'</span>';
    else if(x.score >= (window._discardThreshold||0.11)) st = '<span class="s" style="background:#1a7f37;color:#fff">📋'+x.score.toFixed(2)+'</span>';
    else st = '<span class="s" style="background:#30363d;color:#8b949e">🗑'+x.score.toFixed(2)+'</span>';
    var p = x.price ? ' <b style="color:#d4a72c">Y'+x.price+'</b>' : '';
    var txt = x.formatted || ('弹幕['+x.user+']：'+x.text);
    return '<div class="item">'+st+'<span class="t">'+esc(txt)+p+'</span><span class="a">'+x.time+'</span></div>';
  }).join('');
}
function rlistQueue(arr){
  // 待发射队列：分组显示，每组一个框（组号 + 条数 + 内容）
  if(!arr.length) return '<div style="color:#484f58">暂无</div>';
  return arr.map(function(g, gi){
    var inner = g.map(function(x){
      var txt = x.formatted || ('弹幕['+x.user+']：'+x.text);
      return '<div style="padding:2px 8px;color:#c9d1d9;font-size:13px;line-height:1.6">'+esc(txt)+'</div>';
    }).join('');
    return '<div style="border:1px solid #b08800;border-radius:6px;margin:6px 4px;overflow:hidden">'+
      '<div style="font-size:11px;color:#b08800;background:#1c2128;padding:2px 8px">组 '+(gi+1)+' · '+g.length+'条</div>'+
      inner+'</div>';
  }).join('');
}
function esc(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>
</div><!-- /right -->
<div id="sent" style="width:360px;min-width:280px;display:flex;flex-direction:column;border:1px solid #30363d;border-radius:8px;background:#161b22">
  <h2 style="font-size:15px;padding:10px 12px;border-bottom:1px solid #30363d;color:#8b949e">已发送 <span id="sent-cnt" style="font-size:12px;color:#b08800"></span></h2>
  <div id="sent-feed" style="flex:1;overflow-y:auto;padding:8px 12px;font-size:15px;line-height:1.8"><div style="color:#484f58">暂无</div></div>
</div>
</div><!-- /main -->
</body>
</html>"""

