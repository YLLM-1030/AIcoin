# ============================================================
# 状态
# ============================================================
_state = {'raw': [], 'pending': [], 'saved': [], 'discarded': [], 'sc': [], 'sent': [],
          'saved_sum': 0.0, 'fire_count': 0, 'flush_count': 0,
          'pending_fire': [],          # 待发射队列：list of groups，每组 = 一组 items
          'last_fire_ts': 0.0,         # 上次实际发射到桥的时间戳
          'fire_seq': 0}               # 待发射组序号（前端展示用）
_sent_lock = threading.Lock()   # sent 记录独立锁（避免与 _state_lock 嵌套死锁）
_state_lock = threading.Lock()
_fire_lock = threading.Lock()   # 发射队列独立锁（pending_fire/fire_seq/last_fire_ts，与 _state_lock 隔离，防 _process_danmaku 持锁入队死锁）

# 配置（默认，前端可调）
_config = {'fire': 0.30, 'clip_limit': 0.30, 'discard': 0.11, 'out_bridge': '', 'in_bridge': '19000',
           'cooldown': 5}       # 弹幕发射冷却秒数（同 5s 内最多发射一组）
CONFIG_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'dm_config.json')
def _load_config():
    global _config
    try:
        with open(CONFIG_FILE) as f: _config.update(json.load(f))
    except: pass
def _save_config():
    with open(CONFIG_FILE, 'w') as f: json.dump(_config, f, ensure_ascii=False, indent=2)
_load_config()

# SSE 前端客户端
_front_sse = []; _fsse_lock = threading.Lock()

def _notify_frontend(event='state', data=None):
    if data is None:
        with _state_lock:
            data = dict(_state)
            data['fire_remaining'] = max(0.0, float(_config.get('cooldown', 5) or 5) - (time.time() - _state['last_fire_ts']))
    payload = f'event: {event}\ndata: {json.dumps(data, ensure_ascii=False)}\n\n'.encode()
    with _fsse_lock:
        dead = []
        for wf in _front_sse:
            try: wf.write(payload); wf.flush()
            except: dead.append(wf)
        for wf in dead: _front_sse.remove(wf)

# ============================================================
# 打分 + 弹夹处理
# ============================================================
def _process_danmaku(line_text):
    """处理一条弹幕: '弹幕[user]: text' 或 '[user] text'
    原文(raw)存原样；待分类(pending)存格式化+分数台账；已存(saved)即弹夹，总分超组合阈值自动发桥"""
    now = time.strftime('%H:%M:%S')
    raw_entry = {'line': line_text, 'time': now}
    m = re.match(r'^\[(.+?)\]\s+(.+)', line_text)
    if not m:
        m = re.match(r'^弹幕\[(.+?)\]:\s*(.+)', line_text)
    if not m:
        # 解析不了 → 只进原文
        with _state_lock:
            _state['raw'].append(raw_entry)
            if len(_state['raw']) > 200: _state['raw'] = _state['raw'][-200:]
        _notify_frontend()
        return
    user, text = m.group(1), m.group(2)
    r = combined_score(text, user)
    score = r['final_score']
    pend = {'user': user, 'text': text,
            'formatted': f'弹幕[{user}]：{text}',   # 待分类显示格式（全角冒号，pipeline 同款）
            'score': score, 'time': now, 'addressee': r['addressee']}

    with _state_lock:
        _state['raw'].append(raw_entry)
        if len(_state['raw']) > 200: _state['raw'] = _state['raw'][-200:]

        # 待分类台账：所有可解析弹幕，格式化+分数
        _state['pending'].append(pend)
        if len(_state['pending']) > 200: _state['pending'] = _state['pending'][-200:]

        if score >= _config['fire']:
            # 秒回：已存(弹夹) + 本条 一起进待发射队列（冷却调度发射）
            fire_items = list(_state['saved']) + [pend]
            _state['saved'] = []; _state['saved_sum'] = 0.0
            _state['fire_count'] += 1
            _notify_frontend('fire', {'items': fire_items, 'fire_count': _state['fire_count']})
            _enqueue_fire(fire_items)
        elif score >= _config['discard']:
            # 进已存(弹夹)
            _state['saved'].append(pend)
            _state['saved_sum'] += score
            _auto_flush_saved()
        else:
            _state['discarded'].append(pend)
            if len(_state['discarded']) > 100: _state['discarded'] = _state['discarded'][-100:]

    _notify_frontend()


def _auto_flush_saved():
    """已存(弹夹)总分 ≥ 组合阈值 → 全部已存进待发射队列。调用方需已持有 _state_lock"""
    if _state['saved'] and _state['saved_sum'] >= _config['clip_limit']:
        fire_items = list(_state['saved'])
        _state['saved'] = []; _state['saved_sum'] = 0.0
        _state['flush_count'] += 1
        _notify_frontend('fire', {'items': fire_items, 'flush_count': _state['flush_count']})
        _enqueue_fire(fire_items)

def _fire_to_bridge(items):
    """发送已存弹幕到输出桥；无论成败都记录到 sent（页面最右列展示）"""
    with _sent_lock:
        for x in items:
            _state['sent'].append({'line': f"[{x['user']}] {x['text']}", 'time': x.get('time', '')})
        if len(_state['sent']) > 200: _state['sent'] = _state['sent'][-200:]
    bp = _config.get('out_bridge', '')
    if not bp: return
    # 正确格式：每行一条 弹幕[user]：text（全角冒号，与待分类 formatted 一致）
    lines = [x.get('formatted') or f"弹幕[{x['user']}]：{x['text']}" for x in items]
    try:
        data = json.dumps({'source': '弹幕', 'text': '\n'.join(lines)}).encode()
        req = urllib.request.Request(f'http://localhost:{bp}/text', data=data,
            headers={'Content-Type': 'application/json'}, method='POST')
        urllib.request.urlopen(req, timeout=3)
    except Exception as e:
        print(f'发射到桥{bp}失败: {e}')

# ============================================================
# 发射冷却 + 待发射队列
# ============================================================
def _enqueue_fire(items):
    """把一组弹幕进待发射队列（冷却由调度线程控制发射）。
    用独立 _fire_lock（与 _state_lock 隔离）——调用方（_process_danmaku 秒回 / _auto_flush_saved）已持有
    _state_lock 时调用不再死锁。通知由调用方负责（各自已调 _notify_frontend('fire',...)）。"""
    with _fire_lock:
        _state['pending_fire'].append(list(items))
        _state['fire_seq'] += 1

def _fire_scheduler():
    """发射调度：冷却 ≥ cooldown 且队列非空 → 取队头一组发桥。
    发射在锁外执行（避免 _state_lock/_sent_lock 嵌套）。"""
    while True:
        group = None
        try:
            with _fire_lock:
                now = time.time()
                cd = float(_config.get('cooldown', 5) or 5)
                if _state['pending_fire'] and (now - _state['last_fire_ts']) >= cd:
                    group = _state['pending_fire'].pop(0)
                    _state['last_fire_ts'] = now
        except Exception as e:
            print(f'调度取组失败: {e}')
            group = None
        if group:
            try:
                _fire_to_bridge(group)
            except Exception as e:
                print(f'调度发射失败: {e}')
            _notify_frontend('fire', {'fired_group': group})
        time.sleep(0.3)

# ============================================================
def _input_listener():
    """轮询 /take 读桥 — 读后清空(wait哨兵)：读到非 wait 才逐行处理，天然不重复"""
    import requests
    while True:
        try:
            port = str(_config.get('in_bridge', '19000'))
            r = requests.get(f'http://localhost:{port}/take', timeout=2)
            if r.status_code == 200:
                dm = r.json().get('弹幕', '')
                if dm and dm != 'wait':
                    for line in dm.strip().split('\n'):
                        line = line.strip()
                        if line:
                            _process_danmaku(line)
        except Exception as e:
            print(f'输入桥{port}断开: {e}')
        time.sleep(0.5)

# ============================================================
# HTTP Handler
# ============================================================
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        path = urlparse(self.path).path
        if path == '/':
            self._html(PAGE)
        elif path == '/events':
            self.send_response(200)
            self.send_header('Content-Type', 'text/event-stream')
            self.send_header('Cache-Control', 'no-cache')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.send_header('Connection', 'keep-alive')
            self.end_headers()
            with _fsse_lock: _front_sse.append(self.wfile)
            # 推送当前全量状态
            with _state_lock: data = dict(_state)
            payload = f'event: state\ndata: {json.dumps(data, ensure_ascii=False)}\n\n'.encode()
            try: self.wfile.write(payload); self.wfile.flush()
            except: pass
            # 推配置
            payload = f'event: config\ndata: {json.dumps(_config, ensure_ascii=False)}\n\n'.encode()
            try: self.wfile.write(payload); self.wfile.flush()
            except: pass
            try:
                while True:
                    self.wfile.write(b':ping\n\n'); self.wfile.flush()
                    time.sleep(30)
            except: pass
            finally:
                with _fsse_lock:
                    if self.wfile in _front_sse: _front_sse.remove(self.wfile)
        elif path == '/api/config':
            self._json(200, _config)
        elif path == '/api/state':
            # 全量状态（轮询刷新用，与 SSE state 事件同构：_state + fire_remaining）
            with _state_lock:
                data = dict(_state)
                data['fire_remaining'] = max(0.0, float(_config.get('cooldown', 5) or 5) - (time.time() - _state['last_fire_ts']))
            self._json(200, data)
        else:
            self._json(404, {})
    
    def do_POST(self):
        path = urlparse(self.path).path
        body_len = int(self.headers.get('Content-Length', 0))
        body = json.loads(self.rfile.read(body_len)) if body_len else {}
        
        if path == '/api/config':
            _config.update(body)
            _save_config()
            _notify_frontend('config', _config)
            self._json(200, {'ok': True})
        elif path == '/api/save-all':
            with _state_lock:
                _state['saved'].extend(_state['pending'])
                for p in _state['pending']: _state['saved_sum'] += p.get('score', 0)
                _state['pending'] = []
                _auto_flush_saved()   # 存完可能超阈值 → 自动发
            _notify_frontend()
            self._json(200, {'ok': True})
        elif path == '/api/discard-all':
            with _state_lock:
                _state['discarded'].extend(_state['pending'])
                _state['pending'] = []
            _notify_frontend()
            self._json(200, {'ok': True})
        elif path == '/api/flush':
            with _state_lock:
                items = list(_state['saved'])
                _state['saved'] = []; _state['saved_sum'] = 0.0
            if items:
                _enqueue_fire(items)   # 手动发送也走冷却队列（排队发射）
            _notify_frontend()
            self._json(200, {'ok': True, 'count': len(items), 'queued': len(_state['pending_fire'])})
        elif path == '/api/test':
            text = body.get('text', '')
            user = body.get('user', '观众')
            if text:
                _process_danmaku(f'[{user}] {text}')
            self._json(200, {'ok': True})
        else:
            self._json(404, {})
    
    def _json(self, code, data):
        b = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Content-Length', len(b))
        self.end_headers()
        self.wfile.write(b)
    
    def _html(self, content):
        b = content.encode()
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', len(b))
        self.end_headers()
        self.wfile.write(b)
    
    def do_OPTIONS(self): self.send_response(200); self.end_headers()

