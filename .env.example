# 迷你硬币 运行所需密钥模板
# 用法：复制本文件为 .env，填入真实值，由运行环境注入（.env 已被 .gitignore 排除，不会入库）
# 绝对不要把真实 key 直接写进源码或提交到仓库。

# DeepSeek / 兼容 OpenAI 格式的 LLM 后端 key
# 被以下文件共用：输入中心/mini_coin_llm_bridge.py、输入中心/pipeline_server.py
MINICOIN_LLM_API_KEY=your-deepseek-or-openai-key

# 秘塔(Metaso) 搜索 key
# 被以下文件使用：输入中心/搜索工具/web_search.py
METASO_API_KEY=your-metaso-key

# B站直播开放平台 AK / SK
# 被以下文件使用：输入中心/弹幕接收/blc_collector.py
BILI_OPEN_LIVE_AK_ID=your-ak-id
BILI_OPEN_LIVE_AK_SECRET=your-ak-secret
